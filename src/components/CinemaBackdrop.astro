---
// Capas atmosféricas del hero cinematográfico: viñeta, grano y barrido de luz.
// Deliberadamente hermano de .container en Hero.astro (no anidado dentro), para
// que su containing block sea .vz-hero__cinema a pantalla completa y no una caja
// ajustada al contenido — ver la nota de HeroIntro.astro sobre este mismo bug.
---

<div class="vz-cinema-backdrop" aria-hidden="true">
  <div class="vz-cinema-backdrop__vignette"></div>
  <div class="vz-cinema-backdrop__grain"></div>
  <div class="vz-cinema-backdrop__light"></div>
</div>

<style>
  .vz-cinema-backdrop__vignette,
  .vz-cinema-backdrop__grain,
  .vz-cinema-backdrop__light {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .vz-cinema-backdrop__vignette {
    background: radial-gradient(120% 120% at 30% 42%, transparent 55%, rgb(0 0 0 / 38%) 100%);
  }

  .vz-cinema-backdrop__grain {
    opacity: 0.05;
    mix-blend-mode: overlay;
    background-image: repeating-linear-gradient(
      0deg,
      rgb(244 240 233 / 60%) 0px,
      transparent 1px,
      transparent 2px
    );
  }

  .vz-cinema-backdrop__light {
    background: radial-gradient(32% 45% at 26% 42%, rgb(244 240 233 / 40%), transparent 70%);
    mix-blend-mode: screen;
    opacity: 0;
    animation: vz-light-sweep 3.8s ease-in-out 0.5s forwards;
  }

  @keyframes vz-light-sweep {
    0% {
      opacity: 0;
      transform: translate(-15%, -8%) scale(0.8);
    }
    35% {
      opacity: 0.9;
    }
    65% {
      opacity: 0.4;
      transform: translate(12%, 8%) scale(1.2);
    }
    100% {
      opacity: 0;
      transform: translate(22%, 12%) scale(1.35);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vz-cinema-backdrop__light,
    .vz-cinema-backdrop__grain {
      display: none;
    }
  }
</style>

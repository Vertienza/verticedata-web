---
// Animación de entrada del hero: arranca en el "eco" tipográfico del brandbook
// (wordmark repetido con opacidad decreciente, dentro de un marco de guías) y se
// resuelve en el lockup final (wordmark + claim). Un solo ciclo al cargar, nunca
// en loop. Respeta prefers-reduced-motion (salta directo al estado final).
const rows = [1, 0.55, 0.32, 0.18];
---

<div class="vz-intro" role="img" aria-label="Vertienza — branding, contenido y datos">
  <div class="vz-intro__echo" aria-hidden="true">
    {rows.map((opacity) => (
      <div class="vz-intro__row">
        <img src="/logo/vertienza-logo-blanco.svg" alt="" style={`opacity:${opacity}`} />
      </div>
    ))}
  </div>

  <div class="vz-intro__final" aria-hidden="true">
    <div class="vz-intro__logo">
      <img src="/logo/vertienza-logo-blanco.svg" alt="" />
    </div>
    <p class="vz-intro__tag">branding · contenido · datos</p>
  </div>
</div>

<style>
  .vz-intro {
    position: relative;
    width: clamp(15rem, 30vw, 21rem);
    aspect-ratio: 4 / 3;
    margin-bottom: var(--vz-space-lg);
  }

  .vz-intro__echo,
  .vz-intro__final {
    position: absolute;
    inset: 0;
  }

  /* Etapa 1 — eco: el motivo de repetición del brandbook */
  .vz-intro__echo {
    display: flex;
    flex-direction: column;
    border: 1.5px dashed rgb(244 240 233 / 45%);
    animation: vz-echo-out 2s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  .vz-intro__row {
    flex: 1 1 25%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vz-intro__row img {
    height: 62%;
    width: auto;
    max-width: none;
  }

  /* Etapa 2 — lockup final: wordmark + claim, ya sin marco */
  .vz-intro__final {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6em;
    opacity: 0;
    animation: vz-final-in 2s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  .vz-intro__logo {
    width: 112%;
    overflow: hidden;
  }

  .vz-intro__logo img {
    width: 100%;
    height: auto;
    display: block;
  }

  .vz-intro__tag {
    margin: 0;
    font-family: var(--vz-font-display);
    font-style: italic;
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.375rem);
    color: var(--vz-cream-muted);
  }

  @keyframes vz-echo-out {
    0%,
    30% {
      opacity: 1;
    }
    62%,
    100% {
      opacity: 0;
    }
  }

  @keyframes vz-final-in {
    0%,
    45% {
      opacity: 0;
      transform: translateY(0.4em);
    }
    80%,
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vz-intro__echo {
      display: none;
    }
    .vz-intro__final {
      opacity: 1;
      animation: none;
      transform: none;
    }
  }
</style>

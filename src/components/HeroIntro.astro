---
// Wordmark del hero cinematográfico: parpadea como fotogramas de cine mudo /
// zoótropo (animation-timing-function: steps — salto entre paradas, no
// interpolación suave), con la amplitud del temblor decayendo hasta asentarse.
// Un solo ciclo al cargar. Las capas atmosféricas (viñeta/grano/luz) viven
// aparte en CinemaBackdrop.astro — ver esa nota para el porqué.
---

<div class="vz-cinema-mark" aria-hidden="true">
  <img src="/logo/vertienza-logo-blanco.svg" alt="" class="vz-cinema-mark__flicker" />
</div>
<p class="vz-cinema-mark__tag" aria-hidden="true">branding · contenido · datos</p>
<span class="sr-only">Vertienza — branding, contenido y datos</span>

<style>
  .vz-cinema-mark {
    width: clamp(16rem, 36vw, 32rem);
    overflow: hidden;
  }

  .vz-cinema-mark__flicker {
    width: 100%;
    height: auto;
    display: block;
    opacity: 0;
    animation: vz-flicker 2.9s steps(1) forwards;
    will-change: opacity, transform;
  }

  .vz-cinema-mark__tag {
    margin: 0.9em 0 0;
    font-family: var(--vz-font-display);
    font-style: italic;
    font-size: clamp(1.0625rem, 0.9rem + 0.7vw, 1.5rem);
    color: var(--vz-cream-muted);
    opacity: 0;
    animation: vz-rise-in 1s var(--vz-ease-out) 2.6s forwards;
  }

  @keyframes vz-flicker {
    0% {
      opacity: 0.12;
      transform: scale(0.9) translateY(14px);
    }
    4% {
      opacity: 0.85;
      transform: scale(1.05) translateY(-8px);
    }
    9% {
      opacity: 0.2;
      transform: scale(0.94) translateY(6px);
    }
    14% {
      opacity: 1;
      transform: scale(1.03) translateY(-5px);
    }
    19% {
      opacity: 0.08;
      transform: scale(0.92) translateY(10px);
    }
    24% {
      opacity: 0.8;
      transform: scale(1.06) translateY(-6px);
    }
    30% {
      opacity: 0.25;
      transform: scale(0.95) translateY(4px);
    }
    36% {
      opacity: 1;
      transform: scale(1.02) translateY(-3px);
    }
    42% {
      opacity: 0.35;
      transform: scale(0.97) translateY(4px);
    }
    48% {
      opacity: 0.9;
      transform: scale(1.02) translateY(-2px);
    }
    54% {
      opacity: 0.5;
      transform: scale(0.98) translateY(2px);
    }
    60% {
      opacity: 1;
      transform: scale(1.005) translateY(0);
    }
    67% {
      opacity: 0.7;
      transform: scale(0.99) translateY(1px);
    }
    74% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    82% {
      opacity: 0.88;
      transform: scale(1) translateY(0);
    }
    90%,
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vz-cinema-mark__flicker {
      opacity: 1;
      animation: none;
      transform: none;
    }
    .vz-cinema-mark__tag {
      opacity: 1;
      animation: none;
    }
  }
</style>

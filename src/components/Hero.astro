---
import HeroIntro from './HeroIntro.astro';
import CinemaBackdrop from './CinemaBackdrop.astro';
---

<section class="section section--brand vz-hero" data-vz-section="hero">
  <div class="vz-hero__cinema">
    <CinemaBackdrop />
    <div class="container vz-hero__cinema-inner">
      <HeroIntro />

      <h1 class="h-display h-display--italic h-display--hero vz-hero__title">
        Le damos voz a tu marca.
      </h1>
      <p class="lede vz-hero__lede">
        Con criterio y sin fórmulas: contenido que la mantiene viva, relevante y en primera línea.
      </p>
    </div>
  </div>

  <div class="vz-hero__frame container" data-reveal>
    <a class="vz-hero__media" href="#contacto" aria-label="Conoce nuestros proyectos">
      <!-- Placeholder de proyecto real: sustituir por fotografía propia antes de publicar en producción -->
      <div class="vz-hero__media-fallback" role="img" aria-label="Espacio reservado para fotografía de proyecto">
        <span class="vz-hero__media-tag">Foto de proyecto pendiente</span>
      </div>
      <span class="vz-hero__cta">
        Conoce nuestros proyectos
      </span>
      <span class="vz-hero__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </a>
  </div>
</section>

<style>
  .vz-hero {
    padding-bottom: var(--vz-space-xl);
  }

  .vz-hero__cinema {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: var(--vz-space-2xl);
  }

  .vz-hero__cinema-inner {
    position: relative;
    z-index: 1;
  }

  .vz-hero__title {
    max-width: 16ch;
    margin: var(--vz-space-lg) 0 var(--vz-space-sm);
    opacity: 0;
    animation: vz-rise-in 0.9s var(--vz-ease-out) 3.3s forwards;
  }

  .vz-hero__lede {
    margin: 0;
    opacity: 0;
    animation: vz-rise-in 0.9s var(--vz-ease-out) 3.5s forwards;
  }

  .vz-hero__frame {
    margin-top: var(--vz-space-xl);
  }

  .vz-hero__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 4px;
    overflow: hidden;
    text-decoration: none;
    color: var(--vz-cream);
  }

  .vz-hero__media-fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 140% at 15% 15%, rgb(244 240 233 / 14%), transparent 55%),
      linear-gradient(155deg, var(--vz-brand-600) 0%, #24413a 55%, var(--vz-ink) 100%);
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: var(--vz-space-sm);
    transition: transform 0.6s var(--vz-ease-out);
  }

  .vz-hero__media:hover .vz-hero__media-fallback {
    transform: scale(1.03);
  }

  .vz-hero__media:hover .vz-hero__arrow {
    background: var(--vz-cream);
    color: var(--vz-brand-600);
  }

  .vz-hero__media:hover .vz-hero__arrow svg {
    transform: translateX(0.15em);
  }

  .vz-hero__media-tag {
    font-family: var(--vz-font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--vz-ink);
    background: var(--vz-copper);
    padding: 0.35em 0.75em;
    border-radius: var(--vz-radius-pill);
  }

  .vz-hero__cta {
    position: absolute;
    left: var(--vz-space-md);
    bottom: var(--vz-space-md);
    font-family: var(--vz-font-body);
    font-weight: 600;
    font-size: 1rem;
    text-shadow: 0 1px 12px rgb(0 0 0 / 25%);
  }

  .vz-hero__arrow {
    position: absolute;
    top: var(--vz-space-md);
    right: var(--vz-space-md);
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid rgb(244 240 233 / 55%);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .vz-hero__arrow svg {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 0.3s var(--vz-ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .vz-hero__title,
    .vz-hero__lede {
      opacity: 1;
      animation: none;
    }

    .vz-hero__media-fallback,
    .vz-hero__arrow svg {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .vz-hero__media {
      aspect-ratio: 4 / 5;
    }

    .vz-hero__cta {
      font-size: 0.9375rem;
      left: var(--vz-space-sm);
      bottom: var(--vz-space-sm);
    }
  }
</style>

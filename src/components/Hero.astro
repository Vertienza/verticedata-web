---
import fs from 'node:fs';
import path from 'node:path';

// El vídeo de fondo es opcional a propósito: hasta que exista un reel real
// (Alejandro lo cura a mano, ver conversación), el hero se queda en el
// degradado de marca de siempre — sin <source> roto ni 404 en consola.
// Para activarlo: soltar public/video/hero-reel.mp4 (+ opcional .webm) y
// hacer build de nuevo. Ningún cambio de código.
const videoDir = path.join(process.cwd(), 'public', 'video');
const hasMp4 = fs.existsSync(path.join(videoDir, 'hero-reel.mp4'));
const hasWebm = fs.existsSync(path.join(videoDir, 'hero-reel.webm'));
const hasVideo = hasMp4 || hasWebm;
---

<section class="section section--brand vz-hero" data-tone="dark" data-vz-section="hero">
  <div class="vz-hero__stage">
    {hasVideo && (
      <div class="vz-hero__video-layer" aria-hidden="true">
        <video autoplay muted loop playsinline>
          {hasWebm && <source src="/video/hero-reel.webm" type="video/webm" />}
          {hasMp4 && <source src="/video/hero-reel.mp4" type="video/mp4" />}
        </video>
        <div class="vz-hero__scrim"></div>
      </div>
    )}

    <div class="container vz-hero__stage-inner">
      <div class="vz-hero__mark" aria-hidden="true">
        <img src="/logo/vertienza-logo-blanco.svg" alt="" />
      </div>

      <h1 class="h-display h-display--italic h-display--hero vz-hero__title">
        Le damos voz a tu marca.
      </h1>
      <p class="lede vz-hero__lede">
        Con criterio y sin fórmulas: contenido que la mantiene viva, relevante y en primera línea.
      </p>
    </div>

    <a href="#quienes-somos" class="vz-hero__scroll-cue">
      Descubre más <span aria-hidden="true">↓</span>
    </a>
  </div>

  <div class="vz-hero__frame container" data-reveal>
    <a class="vz-hero__media" href="#contacto" aria-label="Conoce nuestros proyectos">
      <!-- Placeholder de proyecto real: sustituir por fotografía/vídeo propio antes de publicar en producción -->
      <div class="vz-hero__media-fallback" role="img" aria-label="Espacio reservado para fotografía de proyecto">
        <span class="vz-hero__media-tag">Foto de proyecto pendiente</span>
      </div>
      <span class="vz-hero__cta">
        Conoce nuestros proyectos
      </span>
      <span class="vz-hero__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </a>
  </div>
</section>

<style>
  .vz-hero {
    /* .section pone padding-top: 2xl heredado — anulado aquí porque
       .vz-hero__stage ya gestiona su propio espaciado interno dentro
       de sus 100svh (si no, el stage empieza 144px por debajo del
       borde real del viewport y el scroll-cue calcula mal el "bottom"). */
    padding-top: 0;
    padding-bottom: var(--vz-space-xl);
  }

  .vz-hero__stage {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: var(--vz-space-2xl);
    overflow: hidden;
  }

  .vz-hero__video-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .vz-hero__video-layer video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vz-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(21 36 32 / 55%) 0%,
      rgb(21 36 32 / 35%) 45%,
      rgb(21 36 32 / 65%) 100%
    );
  }

  .vz-hero__stage-inner {
    position: relative;
    z-index: 1;
  }

  .vz-hero__scroll-cue {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 4vh, 2.5rem);
    transform: translateX(-50%);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--vz-font-body);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--vz-cream-muted);
    text-decoration: none;
    opacity: 0;
    animation: vz-rise-in 1s var(--vz-ease-out) 1s forwards;
    transition: color 0.2s ease;
  }

  .vz-hero__scroll-cue:hover {
    color: var(--vz-cream);
  }

  .vz-hero__scroll-cue span {
    display: inline-block;
    animation: vz-bob 1.8s ease-in-out infinite;
  }

  @keyframes vz-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(0.2em);
    }
  }

  .vz-hero__mark {
    width: clamp(11rem, 20vw, 15rem);
    margin-bottom: 1.75rem;
    opacity: 0;
    transform: translateY(0.6rem);
    animation: vz-rise-in 1s var(--vz-ease-out) 0.2s forwards;
  }

  .vz-hero__mark img {
    width: 100%;
    height: auto;
    display: block;
  }

  .vz-hero__title {
    max-width: 16ch;
    margin-bottom: var(--vz-space-sm);
    opacity: 0;
    transform: translateY(0.6rem);
    animation: vz-rise-in 1s var(--vz-ease-out) 0.45s forwards;
  }

  .vz-hero__lede {
    margin: 0;
    opacity: 0;
    transform: translateY(0.6rem);
    animation: vz-rise-in 1s var(--vz-ease-out) 0.65s forwards;
  }

  .vz-hero__frame {
    margin-top: var(--vz-space-xl);
  }

  .vz-hero__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 4px;
    overflow: hidden;
    text-decoration: none;
    color: var(--vz-cream);
  }

  .vz-hero__media-fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 140% at 15% 15%, rgb(244 240 233 / 14%), transparent 55%),
      linear-gradient(155deg, var(--vz-brand-600) 0%, #24413a 55%, var(--vz-ink) 100%);
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: var(--vz-space-sm);
    transition: transform 0.6s var(--vz-ease-out);
  }

  .vz-hero__media:hover .vz-hero__media-fallback {
    transform: scale(1.03);
  }

  .vz-hero__media:hover .vz-hero__arrow {
    background: var(--vz-cream);
    color: var(--vz-brand-600);
  }

  .vz-hero__media:hover .vz-hero__arrow svg {
    transform: translateX(0.15em);
  }

  .vz-hero__media-tag {
    font-family: var(--vz-font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--vz-ink);
    background: var(--vz-copper);
    padding: 0.35em 0.75em;
    border-radius: var(--vz-radius-pill);
  }

  .vz-hero__cta {
    position: absolute;
    left: var(--vz-space-md);
    bottom: var(--vz-space-md);
    font-family: var(--vz-font-body);
    font-weight: 600;
    font-size: 1rem;
    text-shadow: 0 1px 12px rgb(0 0 0 / 25%);
  }

  .vz-hero__arrow {
    position: absolute;
    top: var(--vz-space-md);
    right: var(--vz-space-md);
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid rgb(244 240 233 / 55%);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .vz-hero__arrow svg {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 0.3s var(--vz-ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .vz-hero__mark,
    .vz-hero__title,
    .vz-hero__lede,
    .vz-hero__scroll-cue {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .vz-hero__scroll-cue span {
      animation: none;
    }

    .vz-hero__video-layer video {
      display: none;
    }

    .vz-hero__media-fallback,
    .vz-hero__arrow svg {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    /* Choca con el Escríbenos fijo del marco en pantallas estrechas —
       en móvil el gesto de seguir bajando ya es obvio sin la pista. */
    .vz-hero__scroll-cue {
      display: none;
    }

    .vz-hero__media {
      aspect-ratio: 4 / 5;
    }

    .vz-hero__cta {
      font-size: 0.9375rem;
      left: var(--vz-space-sm);
      bottom: var(--vz-space-sm);
    }
  }
</style>

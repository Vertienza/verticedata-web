# Copiar a .env (gitignored) y rellenar antes de tener analítica real.
# Sin estas variables, el snippet de PostHog simplemente no se inyecta (ver src/layouts/Layout.astro) —
# no rompe el build ni el dev server.

# Project API key de PostHog (Settings → Project → Project API Key). Empieza por "phc_".
PUBLIC_POSTHOG_KEY=

# Host de la región del proyecto PostHog. UE por defecto (RGPD) — cambiar solo si el proyecto es US.
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
